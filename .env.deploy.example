# Copy to .env.deploy (gitignored) and fill in. Used by: npm run deploy
# Find host/user in cPanel's General Information panel; enable SSH under
# cPanel → SSH Access and authorize your public key there.
DEPLOY_HOST=server123.web-hosting.com
DEPLOY_PORT=21098
DEPLOY_USER=cpanelusername
# This site's document root. Relative paths start in the cPanel home directory.
DEPLOY_PATH=public_html
# Optional: private key to use (otherwise ssh's defaults / agent).
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# Optional: extra space-separated paths on the server that must never be
# deleted or overwritten (always protected: .well-known cgi-bin .user.ini
# php.ini error_log .deployed-by).
DEPLOY_PROTECT=
