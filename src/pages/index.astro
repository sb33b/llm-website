---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import NetworkGraphic from '../components/NetworkGraphic.astro';
import StatsStrip from '../components/StatsStrip.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Eye from '../components/icons/Eye.astro';
import Parcel from '../components/icons/Parcel.astro';
import MapPin from '../components/icons/MapPin.astro';

const whyPartner = [
  {
    icon: Eye,
    title: 'Live visibility',
    body: "See your parcel's status the moment it changes — no calls, no chasing anyone for an update.",
  },
  {
    icon: Parcel,
    title: 'One manifest, one pickup',
    body: 'Send us a manifest and we pick your parcels up from your nearest superhub. From there, it’s on us.',
  },
  {
    icon: MapPin,
    title: 'Reach past the end of the road',
    body: 'Our TODA courier network gets parcels into barangays a standard fleet would otherwise have to write off.',
  },
];
---

<BaseLayout
  title="Last Last Mile"
  description="Last Last Mile partners with express delivery companies and local TODAs to deliver parcels into areas standard courier networks can't reach."
  path="/"
>
  <section class="section hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">B2B Last-Mile Logistics</span>
        <h1>Take your parcel to the LAST last mile.</h1>
        <p class="hero__lead text-muted">
          Last Last Mile partners with express delivery companies and local tricycle associations
          (TODAs) to get parcels into barangays a standard courier network struggles to reach — with every
          step logged, verified, and traceable from manifest to doorstep.
        </p>
        <div class="cluster">
          <Button href="/partner-with-us.html" variant="primary">Partner With Us</Button>
          <Button href="/download.html" variant="secondary">Download the App</Button>
        </div>
      </div>
      <div class="hero__visual">
        <NetworkGraphic />
      </div>
    </div>
  </section>

  <section class="section section--tight section--surface">
    <div class="container">
      <StatsStrip />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Getting Started</span>
        <h2>Three steps, one point of contact.</h2>
      </div>
      <HowItWorks />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">For Express Companies</span>
        <h2>Why partner with us</h2>
      </div>
      <div class="grid grid--3">
        {whyPartner.map((item) => {
          const Icon = item.icon;
          return (
            <div class="feature-card">
              <div class="feature-card__icon"><Icon size={24} /></div>
              <h3>{item.title}</h3>
              <p class="text-muted">{item.body}</p>
            </div>
          );
        })}
      </div>
      <div class="express-cta">
        <Button href="/partner-with-us.html#for-express" variant="primary">Partner with us</Button>
      </div>
    </div>
  </section>

  <section class="section section--dark toda-cta">
    <div class="container toda-cta__grid">
      <div>
        <span class="eyebrow">For TODAs & Couriers</span>
        <h2>Turn your tricycle into a delivery route.</h2>
        <p class="text-muted">
          We work directly with TODA associations across CALABARZON — extra
          income delivering parcels on routes you already ride, no unfamiliar territory.
        </p>
        <Button href="/partner-with-us.html#for-toda-courier" variant="primary">Learn more</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .hero__lead {
    font-size: 1.1rem;
    max-width: 46ch;
  }

  .hero__visual {
    max-width: 480px;
    margin-inline: auto;
  }

  .section-heading {
    max-width: 80ch;
    margin-bottom: 2.5rem;
  }

  .feature-card {
    padding: 1.5rem;
  }

  .feature-card__icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: rgba(46, 50, 53, 0.06);
    color: var(--color-charcoal);
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.1rem;
  }

  .feature-card p {
    font-size: 0.95rem;
    margin-bottom: 0;
  }

  .express-cta {
    margin-top: 2.5rem;
  }

  .toda-cta__grid > div {
    max-width: 80ch;
  }
</style>
