---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactInfo } from '../data/contact-info';
---

<BaseLayout
  title="Privacy Policy"
  description="How Last Last Mile handles the information collected through this website and the Last Last Mile app."
  path="/privacy.html"
>
  <section class="section legal">
    <div class="container legal__inner">
      <span class="eyebrow">Privacy Policy</span>
      <h1>Privacy Policy</h1>
      <p class="text-muted mono">Last updated: August 29, 2026</p>

      <h2>What this site collects</h2>
      <p>
        This website does not run any tracking scripts, analytics, or cookies of its own, and it has
        no forms that submit data anywhere. The only way to send us information from this site is by
        emailing us directly — for example, using the email link on our Partner page, which opens
        your own email app addressed to us. Whatever you choose to include in that email (such as
        your name, TODA affiliation, or contact number) is sent the same way any email is: to our
        inbox, under our control, used only to follow up with you about partnering.
      </p>

      <h2>The Last Last Mile app</h2>
      <p>
        The Last Last Mile mobile app, used by our partner team, handles operational data — including
        parcel and delivery records — under its own account system. A full description of that
        handling will be published here as this policy matures.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy can be sent to <a href={`mailto:${contactInfo.email.general}`}>{contactInfo.email.general}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal__inner {
    max-width: 68ch;
  }

  .legal h2 {
    margin-top: 2rem;
  }
</style>
