---
import BaseLayout from '../layouts/BaseLayout.astro';

const provinces = ['Cavite', 'Batangas', 'Laguna', 'Rizal', 'Quezon'];
---

<BaseLayout
  title="About"
  description="Last Last Mile closes the gap between express couriers and the barangays a standard network can't reach — with live visibility and a TODA partnership model, from manifest to doorstep."
  path="/about.html"
>
  <section class="section">
    <div class="container about-hero">
      <span class="eyebrow">About Us</span>
      <h1>Closing the last last mile.</h1>
      <p class="text-muted about-hero__lead">
        Express couriers can get a parcel most of the way — into a city, a hub, a terminal. What
        happens after that, into a barangay with no formal address or a road a delivery van can't
        take, is the gap we exist to close. We partner with express delivery companies and local
        tricycle drivers' associations (TODAs) to carry parcels the rest of the way.
      </p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container philosophy">
      <div class="philosophy__copy">
        <span class="eyebrow">Our Philosophy</span>
        <h2>Live visibility, not guesswork.</h2>
        <p class="text-muted">
          You always know where a parcel is — not because someone remembered to update a spreadsheet,
          but because we track it live, end to end. If it says delivered, it's because delivery was
          confirmed on the spot, not because someone marked a box.
        </p>
      </div>
      <div class="philosophy__card card">
        <p class="mono philosophy__quote">"If it says delivered, it's because delivery was confirmed — not because someone marked a box."</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container network-note">
      <span class="eyebrow">The Network</span>
      <h2>Built on local partnerships.</h2>
      <p class="text-muted">
        Underneath every delivery is a network of TODA associations and individual couriers who
        already know these roads — we give them the routes, the visibility, and the extra
        income to make delivering parcels worth the trip.
      </p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container coverage">
      <span class="eyebrow">Where We Operate</span>
      <h2>CALABARZON, and growing.</h2>
      <p class="text-muted coverage__lead">
        Today, we aim to have our network cover all five CALABARZON provinces, reaching dozens of municipalities
        through a mix of hubs, terminals, and courier drop points.
      </p>
      <ul class="coverage__list">
        {provinces.map((province) => (
          <li>{province}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    max-width: 70ch;
  }

  .about-hero__lead {
    font-size: 1.1rem;
  }

  .philosophy {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .philosophy {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .philosophy__card {
    background: var(--color-charcoal);
    color: var(--color-white);
  }

  .philosophy__quote {
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }

  .network-note {
    max-width: 60ch;
  }

  .coverage {
    max-width: 60ch;
  }

  .coverage__lead {
    font-size: 1.05rem;
  }

  .coverage__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
    margin-top: 1.5rem;
  }

  .coverage__list li {
    font-family: var(--font-heading);
    font-weight: 600;
    padding: 0.6rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-pill);
  }
</style>
