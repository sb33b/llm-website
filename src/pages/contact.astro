---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Mail from '../components/icons/Mail.astro';
import Phone from '../components/icons/Phone.astro';
import MapPin from '../components/icons/MapPin.astro';
import { contactInfo } from '../data/contact-info';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Last Last Mile — general inquiries, partnership questions, and our office details."
  path="/contact.html"
>
  <section class="section contact-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Get in touch.</h1>
      <p class="text-muted contact-hero__lead">
        Have a question about partnering with us, tracking down a shipment, or something else
        entirely? Reach us directly, or see how to become a TODA or courier partner.
      </p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="grid grid--3 contact-cards">
        <div class="card contact-card">
          <div class="contact-card__icon"><Mail size={22} /></div>
          <h3>Email</h3>
          <p class="text-muted">General inquiries</p>
          <a href={`mailto:${contactInfo.email.general}`} class="contact-card__value">{contactInfo.email.general}</a>
        </div>

        <div class="card contact-card">
          <div class="contact-card__icon"><Phone size={22} /></div>
          <h3>Phone</h3>
          <p class="text-muted">Mon–Sat, business hours</p>
          <a href={contactInfo.phone.href} class="contact-card__value">{contactInfo.phone.display}</a>
        </div>

        <div class="card contact-card">
          <div class="contact-card__icon"><MapPin size={22} /></div>
          <h3>Office</h3>
          <p class="text-muted">By appointment</p>
          <p class="contact-card__value contact-card__value--address">
            {contactInfo.address.line1}<br />
            {contactInfo.address.line2}<br />
            {contactInfo.address.line3}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container partner-pointer">
      <h2>Looking to become a partner?</h2>
      <p class="text-muted">
        If you're a TODA association or an individual courier interested in joining the network, our
        Partner page has everything you need — including how to reach our partnerships team directly.
      </p>
      <Button href="/partner-with-us.html" variant="primary">Partner With Us</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero__lead {
    font-size: 1.1rem;
    max-width: 60ch;
  }

  .contact-cards {
    align-items: stretch;
  }

  .contact-card {
    text-align: left;
  }

  .contact-card__icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: rgba(251, 184, 7, 0.14);
    color: var(--color-gold-dark);
    margin-bottom: 1rem;
  }

  .contact-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.15rem;
  }

  .contact-card p.text-muted {
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .contact-card__value {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-charcoal);
  }

  a.contact-card__value:hover {
    color: var(--color-gold-dark);
  }

  .contact-card__value--address {
    font-weight: 500;
    font-family: var(--font-body);
    line-height: 1.5;
  }

  .partner-pointer {
    max-width: 55ch;
  }
</style>
